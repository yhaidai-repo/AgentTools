{
  "name": "agenttools",
  "private": true,
  "workspaces": [
    "AgentConfig",
    "AgentRuntime",
    "AgentUsage",
    "Adoa/packages/*",
    "Adoa/apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "adoa:db:generate": "npm run generate -w @adoa/db",
    "adoa:dev:web": "npm run dev -w @adoa/web"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "adoa",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "npm run generate -w @adoa/db",
    "db:migrate": "npm run migrate -w @adoa/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @adoa/web",
    "dev:worker": "npm run dev -w @adoa/worker"
  },
  "engines": {
    "node": ">=22"
  }
}

  "components": {
    "schemas": {
      "AddRecordRequest": {
        "required": [
          "kind",
          "sourceId"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/RecordKind"
          },
          "sourceId": {
            "type": "string"
          }
        }
      },
      "AddVaultRequest": {
        "required": [
          "folder"
        ],
        "type": "object",
        "properties": {
          "folder": {
            "type": "string"
          }
        }
      },
      "AddedVault": {
        "required": [
          "vault",
          "created"
        ],
        "type": "object",
        "properties": {
          "vault": {
            "type": "string"
          },
          "created": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ChatKind": {
        "enum": [
          "pbi",
          "item",
          "review",
          "vault"
        ]
      },
      "ChatLink": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "ConnectionCheck": {
        "required": [
          "ok",
          "message"
        ],
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "DeleteRequest": {
        "required": [
          "adoIds"
        ],
        "type": "object",
        "properties": {
          "adoIds": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        }
      },
      "DeletedPbi": {
        "required": [
          "adoId",
          "title"
        ],
        "type": "object",
        "properties": {
          "adoId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "DeletedPbis": {
        "required": [
          "deleted",
          "refused"
        ],
        "type": "object",
        "properties": {
          "deleted": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeletedPbi"
            }
          },
          "refused": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LauncherAvailability": {
        "required": [
          "label",
          "problem"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "problem": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OpenChatRequest": {
        "required": [
          "kind",
          "id"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ChatKind"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "PbiSyncSettingsRequest": {
        "required": [
          "enabled",
          "cron",
          "maxItemsPerRun",
          "sprint"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "cron": {
            "type": "string"
          },
          "maxItemsPerRun": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sprint": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PrepareRequest": {
        "required": [
          "adoIds"
        ],
        "type": "object",
        "properties": {
          "adoIds": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        }
      },
      "PreparedPbis": {
        "required": [
          "queued",
          "unknown"
        ],
        "type": "object",
        "properties": {
          "queued": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          "unknown": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PullRequestSettingsRequest": {
        "required": [
          "enabled",
          "cron",
          "maxPullRequestsPerRun",
          "repos"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "cron": {
            "type": "string"
          },
          "maxPullRequestsPerRun": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "repos": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RecordKind": {
        "enum": [
          "www",
          "open-question",
          "known-issue"
        ]
      },
      "RemovedVault": {
        "required": [
          "vault"
        ],
        "type": "object",
        "properties": {
          "vault": {
            "type": "string"
          }
        }
      },
      "SaveConnectionRequest": {
        "required": [
          "enabled",
          "orgUrl",
          "project",
          "team",
          "user",
          "pat"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "orgUrl": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "pat": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SavedConnection": {
        "required": [
          "enabled"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "SavedSettings": {
        "required": [
          "enabled"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "SyncPbisRequest": {
        "required": [
          "vault",
          "adoId"
        ],
        "type": "object",

  "components": {
    "schemas": {
      "AddRecordRequest": {
        "required": [
          "kind",
          "sourceId"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/RecordKind"
          },
          "sourceId": {
            "type": "string"
          }
        }
      },
      "AddVaultRequest": {
        "required": [
          "folder"
        ],
        "type": "object",
        "properties": {
          "folder": {
            "type": "string"
          }
        }
      },
      "AddedVault": {
        "required": [
          "vault",
          "created"
        ],
        "type": "object",
        "properties": {
          "vault": {
            "type": "string"
          },
          "created": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ChatKind": {
        "enum": [
          "pbi",
          "item",
          "review",
          "vault"
        ]
      },
      "ChatLink": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "LauncherAvailability": {
        "required": [
          "label",
          "problem"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "problem": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OpenChatRequest": {
        "required": [
          "kind",
          "id"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ChatKind"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecordKind": {
        "enum": [
          "www",
          "open-question",
          "known-issue"
        ]
      },
      "RemovedVault": {
        "required": [
          "vault"
        ],
        "type": "object",
        "properties": {
          "vault": {
            "type": "string"
          }
        }
      },
      "TrashEntry": {
        "required": [
          "path",
          "sizeBytes",
          "modifiedAt"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TrashPathRequest": {
        "required": [
          "path"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "PowerLoom.Features.Vaults.Trash.TrashEndpoints"
    },
    {
      "name": "PowerLoom.Features.Vaults.Remove.RemoveVaultEndpoint"
    },
    {
      "name": "PowerLoom.Features.Vaults.Add.AddVaultEndpoint"
    },
    {
      "name": "PowerLoom.Features.Docs.Records.RecordsEndpoints"
    },
    {
      "name": "PowerLoom.Features.Continue.ChatsEndpoints"
    }
  ]

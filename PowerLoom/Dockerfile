# Build context: the PowerLoom folder (see docker-compose.yml).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# Project files first, so a code change doesn't restore packages again.
COPY Directory.Build.props Directory.Packages.props nuget.config ./
COPY src/PowerLoom.Api/PowerLoom.Api.csproj src/PowerLoom.Api/
COPY src/PowerLoom.Core/PowerLoom.Core.csproj src/PowerLoom.Core/
COPY src/PowerLoom.AdoIntegration/PowerLoom.AdoIntegration.csproj src/PowerLoom.AdoIntegration/
COPY src/PowerLoom.ConfluenceIntegration/PowerLoom.ConfluenceIntegration.csproj src/PowerLoom.ConfluenceIntegration/
COPY src/PowerLoom.SqlIntegration/PowerLoom.SqlIntegration.csproj src/PowerLoom.SqlIntegration/
COPY src/PowerLoom.AzureIntegration/PowerLoom.AzureIntegration.csproj src/PowerLoom.AzureIntegration/
COPY src/PowerLoom.DevHubIntegration/PowerLoom.DevHubIntegration.csproj src/PowerLoom.DevHubIntegration/
COPY src/PowerLoom.GitHubIntegration/PowerLoom.GitHubIntegration.csproj src/PowerLoom.GitHubIntegration/
COPY src/PowerLoom.Contracts/PowerLoom.Contracts.csproj src/PowerLoom.Contracts/
COPY src/PowerLoom.Domain/PowerLoom.Domain.csproj src/PowerLoom.Domain/
COPY src/PowerLoom.Persistence/PowerLoom.Persistence.csproj src/PowerLoom.Persistence/
RUN dotnet restore src/PowerLoom.Api/PowerLoom.Api.csproj && dotnet restore src/PowerLoom.Api/PowerLoom.Api.csproj -p:Configuration=Release
COPY src src
# Wolverine's handler code is generated by a Debug build (it has Roslyn; no database needed) and compiled into the
# Release publish, which has no Roslyn. The OpenAPI document is committed, not regenerated here.
RUN dotnet build src/PowerLoom.Api/PowerLoom.Api.csproj -c Debug -p:OpenApiGenerateDocuments=false  && dotnet run --no-build -c Debug --project src/PowerLoom.Api -- codegen write  && dotnet publish src/PowerLoom.Api/PowerLoom.Api.csproj -c Release -p:OpenApiGenerateDocuments=false -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
# curl for the compose healthcheck; PowerShell 7 for the VaultCapture module (records into a vault's registers).
ARG PWSH_VERSION=7.6.6
RUN apt-get update && apt-get install -y --no-install-recommends curl less libgssapi-krb5-2 && rm -rf /var/lib/apt/lists/*  && curl -sSL -o /tmp/pwsh.tar.gz https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell-${PWSH_VERSION}-linux-x64.tar.gz  && mkdir -p /opt/microsoft/powershell/7 && tar zxf /tmp/pwsh.tar.gz -C /opt/microsoft/powershell/7  && chmod +x /opt/microsoft/powershell/7/pwsh && ln -s /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh && rm /tmp/pwsh.tar.gz
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "PowerLoom.Api.dll"]

# Copy to .env and fill in. .env is git-ignored.

# Postgres
POSTGRES_USER=adoa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adoa
DB_PORT=5442                      # host port, bound to 127.0.0.1 only

# Web UI
WEB_PORT=3100                     # host port, bound to 127.0.0.1 only
POWERLOOM_PORT=5180               # the .NET backend's API, bound to 127.0.0.1 only
TELEMETRY_PORT=3200               # Aspire Dashboard, bound to 127.0.0.1 only; with observability on
MCP_PORT=3110                     # the MCP server for Claude chats (http://127.0.0.1:3110/mcp), bound to 127.0.0.1 only

# Local logs, metrics and traces in standalone Aspire Dashboard, retained across restarts with bounded storage.
# Off while the exporter is empty. To switch on: COMPOSE_PROFILES=observability,
# OTEL_EXPORTER_OTLP_ENDPOINT=http://telemetry:4317, TELEMETRY_URL=http://127.0.0.1:3200, then docker compose up -d.
# Existing installations: deploy-web.ps1 replaces the old container without deleting its historical volume.
COMPOSE_PROFILES=
OTEL_EXPORTER_OTLP_ENDPOINT=
TELEMETRY_URL=
TELEMETRY_API_KEY=                # optional: inspection key when using an API-key-secured Aspire service

# Folders (host paths)
# Optional desktop chat histories, discovered by scripts/Set-DesktopChatHistory.ps1 (also run by install.ps1).
# These are read-only mounts of session metadata/history; they never mount either app's login files.
CODEX_DESKTOP_SESSIONS_PATH=./desktop-chats/codex/sessions
CODEX_DESKTOP_INDEX_PATH=./desktop-chats/codex/session_index.jsonl
CLAUDE_DESKTOP_SESSIONS_PATH=./desktop-chats/claude
VAULT_PATH=D:/Claude/powerloom-backlog   # PowerLoom's backlog Obsidian vault (folder name = vault name); each vault's backlog is a folder in it
# Folder holding every Obsidian vault (mounted at /vaults): scheduled vault reviews and the tech-writer's actualize tasks.
VAULTS_ROOT=D:/Claude
# Vault folders never offered to vault reviews (comma-separated); PowerLoom's own backlog vault by default.
VAULTS_EXCLUDE=powerloom-backlog
DOCS_EXCLUDE=backlog   # folders in the docs vault hidden from agents (comma-separated)
SKILLS_PATH=C:/Users/gayda/.claude/skills   # skills agents may load, read-only
# Folder holding the repos (D:/Projects/<repo>): "Continue with Claude" adds the design's repos from here to the chat.
REPOS_ROOT=D:/Projects
AGENTTOOLS_PATH=D:/Projects/AgentTools   # VaultUsage and VaultCapture on the PC: "Configure with <agent>" adds a new vault to them
# The agent app "Continue with …" chats open in while Settings → AI providers has none chosen; one launcher per app.
CONTINUE_LAUNCHER=claude-desktop

# Database backups (host folder, cron in UTC, days kept)
BACKUP_PATH=./backups
BACKUP_CRON=0 2 * * *
BACKUP_KEEP_DAYS=14

# PBI import inbox (host folder): tools outside Docker drop one JSON import request per file here
IMPORT_INBOX_PATH=./import-inbox

# Secrets (needed from phase 2 on)
# Confluence Cloud, read only: your Atlassian email and an API token (id.atlassian.com → Security → API tokens).
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Required trusted HTTPS site for authenticated Confluence access, e.g. https://<company>.atlassian.net
CONFLUENCE_SITE=
# Optional fallback: the Claude token is saved in Settings → AI providers; this one is used only while none is saved there.
CLAUDE_CODE_OAUTH_TOKEN=
# The bearer token a chat sends to the MCP server (the vaults' .mcp.json); any long random string, e.g. `openssl rand -hex 24`.
MCP_TOKEN=

# Sandbox, for coding runs (README "Sandbox for coding runs"). Off while SANDBOX_URL is empty. To switch it on: add
# `sandbox` to COMPOSE_PROFILES, build the image (docker build -t powerloom-sandbox - < Dockerfile.sandbox), set
# SANDBOX_URL=http://sandbox:3300 and long random values for the token and the proxy secret, then docker compose up -d.
SANDBOX_URL=
SANDBOX_TOKEN=                    # the agent-runner's key to the sandbox service; the service refuses to start without it
SANDBOX_PROXY_SECRET=             # signs each restore's pass with its vault's package hosts; empty = SANDBOX_PACKAGE_HOSTS for all

# GSD for coding runs (planning and implementation agents): `npm install @opengsd/gsd-core@1.19.0` in a folder under
# REPOS_ROOT on the PC, then its path as the agent-runner sees it (REPOS_ROOT is /repos there). Empty = no GSD workspace.
GSD_CORE_DIR=                     # e.g. /repos/powerloom-gsd-core/node_modules/@opengsd/gsd-core

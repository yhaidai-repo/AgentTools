<Project Sdk="Microsoft.NET.Sdk">

  <!-- The resident process with a window: tray icon, conversation bubbles, level meters, Start/Stop; hosts the same
       RecorderDaemon the CLI drives through its control files and the hotkey. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PowerLoom.AudioCapture.Ui</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for NotifyIcon (the tray icon); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <OutDir>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms stays explicit (TrayIcon.cs only): its implicit using makes Application and MessageBox ambiguous with WPF. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerLoom.AudioCapture.Core\PowerLoom.AudioCapture.Core.csproj" />
    <!-- Build after the CLI (shared output folder): no assembly reference, only ordering. -->
    <ProjectReference Include="..\PowerLoom.AudioCapture\PowerLoom.AudioCapture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

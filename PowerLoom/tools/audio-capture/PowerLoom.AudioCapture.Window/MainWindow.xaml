<Window x:Class="PowerLoom.AudioCapture.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PowerLoom.AudioCapture.Ui"
        Title="PowerLoom audio capture" Width="520" Height="720" MinWidth="380" MinHeight="400"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextForeground}" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />

        <Style x:Key="MeterBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="{DynamicResource MeterTrack}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style x:Key="SpeakerLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="44" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SpeakingDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Fill" Value="{DynamicResource Accent}" />
            <Setter Property="Opacity" Value="0.15" />
        </Style>

        <DataTemplate DataType="{x:Type ui:BubbleViewModel}">
            <Border x:Name="Bubble" MaxWidth="400" Margin="0,4" Padding="12,8" CornerRadius="12"
                    BorderThickness="1" BorderBrush="{DynamicResource BubbleBorder}"
                    Background="{DynamicResource ThemBubble}" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,3">
                        <Run Text="{Binding Speaker, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Time, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMe}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource MeBubble}" />
                </DataTrigger>
                <!-- Live text: dimmed and italic until the final pass replaces it. -->
                <DataTrigger Binding="{Binding IsProvisional}" Value="True">
                    <Setter TargetName="Bubble" Property="Opacity" Value="0.7" />
                    <Setter TargetName="Bubble" Property="TextBlock.FontStyle" Value="Italic" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and Start/Stop -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                     IsReadOnly="{Binding IsRecording}" ToolTip="Meeting name; empty = the Teams call window's title" />
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,6" MinWidth="130" Command="{Binding ToggleCommand}"
                    Content="{Binding ToggleText}" FontWeight="SemiBold">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Recording}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Status line -->
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed}" FontFamily="Consolas" FontSize="15"
                       Foreground="{DynamicResource Recording}" />
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Level meters -->
        <Grid Grid.Row="2" Margin="0,10,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Me" Style="{StaticResource SpeakerLabel}" />
            <ProgressBar Grid.Row="0" Grid.Column="1" Style="{StaticResource MeterBar}" Value="{Binding MicLevel, Mode=OneWay}" />
            <Ellipse Grid.Row="0" Grid.Column="2" Style="{StaticResource SpeakingDot}" Opacity="{Binding MicLevel, Mode=OneWay}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Them" Style="{StaticResource SpeakerLabel}" Margin="0,6,0,0" />
            <ProgressBar Grid.Row="1" Grid.Column="1" Style="{StaticResource MeterBar}" Margin="0,6,0,0"
                         Value="{Binding SystemLevel, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
            <Ellipse Grid.Row="1" Grid.Column="2" Style="{StaticResource SpeakingDot}" Margin="8,6,0,0"
                     Fill="{DynamicResource Muted}" Opacity="{Binding SystemLevel, Mode=OneWay}" />
        </Grid>

        <!-- Conversation: the voices of the session (type a name, Enter) above the bubbles -->
        <DockPanel Grid.Row="3" Margin="0,6,0,0">
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Speakers}" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:SpeakerViewModel}">
                        <Border Margin="0,0,8,4" Padding="8,4" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BubbleBorder}"
                                Background="{DynamicResource ThemBubble}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MinWidth="90" Padding="4,2"
                                         BorderThickness="0" Background="Transparent" ToolTip="Name this voice; Enter saves it for later meetings"
                                         KeyDown="OnSpeakerKeyDown" LostFocus="OnSpeakerLostFocus" />
                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ScrollViewer x:Name="Conversation" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Bubbles}" Margin="0,0,8,0" />
            </ScrollViewer>
        </DockPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Open folder" Padding="10,4" Command="{Binding OpenFolderCommand}" />
            <TextBlock Text="Close hides the window; the tray icon keeps recording available." Foreground="{DynamicResource Muted}"
                       FontSize="11" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>

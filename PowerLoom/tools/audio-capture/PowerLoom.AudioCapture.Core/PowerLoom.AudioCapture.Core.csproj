<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PowerLoom.AudioCapture</RootNamespace>
    <!-- Windows only: WASAPI capture and loopback, Win32 hotkeys and windows. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Whisper.net's native runtimes ship for x64 only. -->
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Whisper.net.Runtime.Cuda" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
    <!-- Speaker diarization and voice prints (pyannote segmentation + speaker embeddings as ONNX), offline. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" />
    <!-- The segmentation model ships as tar.bz2. -->
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

</Project>
